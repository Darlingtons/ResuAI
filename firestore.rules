rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Users Collection ──────────────────────────────────────────────────────
    // Each user can only read and write their own profile document
    match /users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // ─── Resumes Collection ────────────────────────────────────────────────────
    match /resumes/{resumeId} {
      // Read only if authenticated and the resume belongs to the user
      allow read: if request.auth != null
                  && request.auth.uid == resource.data.userId;

      // Create only if authenticated and setting their own userId
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.userId;

      // Update/Delete only if authenticated and they own the resume
      allow update, delete: if request.auth != null
                            && request.auth.uid == resource.data.userId;
    }

    // Block everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
